{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "拾影",
  "version": "0.8.0-alpha.3",
  "identifier": "com.photofitpicker.next",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "拾影",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/photo-engine"],
    "resources": {
      "../../demo-photos/": "demo-photos/"
    },
    "icon": [
      "icons/app-icon.png",
      "icons/app.icns",
      "icons/app.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "wix": null
    }
  }
}
